(version 1)

# JLCPCB 2-layer 1oz standard-tier rules.
# numbers from jlcpcb.com/capabilities/pcb-capabilities, see hardware/ROUTING.md
# for what each one is guarding against. the board-wide minimums (track, clearance,
# annular ring, edge clearance) live in Board Setup, not here. these are the ones
# the Board Setup dialog cant express because they only apply to one item type.

# 0.15 mm drills cost extra at JLC. 0.3 is the free floor.
(rule "jlc_via_drill_no_surcharge"
	(constraint hole_size (min 0.3mm) (max 6.3mm))
	(condition "A.Type == 'Via'"))

(rule "jlc_via_pad_no_surcharge"
	(constraint via_diameter (min 0.6mm))
	(condition "A.Type == 'Via'"))

# JLC quotes via hole-to-hole 0.2 and pad hole-to-hole 0.45. Board Setup only
# takes one number, so it holds the 0.25 middle and these two split it properly.
(rule "jlc_via_hole_to_hole"
	(constraint hole_to_hole (min 0.2mm))
	(condition "A.Type == 'Via' && B.Type == 'Via'"))

(rule "jlc_pad_hole_to_hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

# JLC wants 0.28 PTH-to-track, 0.35 recommended. 0.3 splits it.
(rule "jlc_pth_to_track"
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))
