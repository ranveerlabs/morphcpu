# pin constraints, iCE40UP5K-SG48I.
# hardware/DESIGN.md is the source of truth, these agree with it, all 20.
#
# do not assign: 1 22 33 (VCCIO) 24 (VPP) 5 30 (VCC) 29 (VCCPLL) 49 (GND paddle)
#                7 CDONE  8 CRESET_B  14-17 SPI  39-41 RGB drivers
#                20 IOB_25b_G3, kept free for a second global clock

# 35 is IOT_46b_G0 -> GBUF0. has to be a driven clock, no crystal amp in the part
set_io -nowarn clk        35

# button to GND, external pullup. user I/O on purpose, not CRESET_B, so a press
# keeps the loaded topology instead of reloading the bitstream
set_io -nowarn rst_n      10

# bank 0, not 6/9. U2 sits due east and 6/9 face west so the old pair dragged
# both nets across the whole board
set_io -nowarn uart_tx_o  34
set_io -nowarn uart_rx_i  36

# cell 0 top-left, row-major. silkscreen has to match or the ripple reads
# scrambled. split across banks, 80 mA total, 5 mA each vs an 8 mA ceiling
set_io -nowarn led[0]      2
set_io -nowarn led[1]      3
set_io -nowarn led[2]     23
set_io -nowarn led[3]     27
set_io -nowarn led[4]     12
set_io -nowarn led[5]     13
set_io -nowarn led[6]     18
set_io -nowarn led[7]     19
set_io -nowarn led[8]     21
set_io -nowarn led[9]      9
set_io -nowarn led[10]    25
set_io -nowarn led[11]    26
set_io -nowarn led[12]    48
set_io -nowarn led[13]    46
set_io -nowarn led[14]    38
set_io -nowarn led[15]    32
